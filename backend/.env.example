# SAS RESERVE — backend environment configuration
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Optional — falls back to SQLite when unset.
#
# DATABASE_URL=postgres://user:password@localhost:5432/sas_reserve


# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173


# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# Create these credentials in:
# Google Cloud Console → APIs & Services → Credentials
#
# OAuth client type:
# Web application
#
# IMPORTANT:
# Never put the real client secret in this example file.
# Never commit the real .env file.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The OAuth redirect_uri sent to Google for the authorization-code exchange.
# MUST match an Authorized redirect URI in Google Cloud Console
# character-for-character (scheme, host, port, path, no trailing params).
#
# Local development with the backend on 127.0.0.1:8000:
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback/
#
# Production example:
# GOOGLE_REDIRECT_URI=https://your-production-domain.com/api/auth/google/callback/
#
# If left empty, the backend falls back to the host the browser actually used
# to reach Django — fine when Google redirects straight to the backend, but
# setting the pin explicitly is strongly recommended.


# ---------------------------------------------------------------------------
# Email — none.
# ---------------------------------------------------------------------------
# Authentication and reservation notifications no longer send any email.
# This application requires no SMTP/email credentials. Email sending is
# intentionally disabled; any EMAIL_* variables from an older setup can be
# deleted from backend/.env and from your hosting provider.


# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Public origin of the React application.
# Production fallback for OAuth redirects and email links.

PUBLIC_FRONTEND_URL=http://localhost:5173

# OAuth redirect origins trusted IN ADDITION to localhost (DEBUG only) and
# current VS Code Dev Tunnels (see ALLOW_DEV_TUNNELS). Exact origins only.
# Example:
# FRONTEND_ALLOWED_ORIGINS=https://myapp.example.com,https://staging.example.com
FRONTEND_ALLOWED_ORIGINS=

# Trust any https://<id>-<port>.<region>.devtunnels.ms origin for OAuth
# redirects, CORS, and (DEBUG only) ALLOWED_HOSTS. Default: true when
# DJANGO_DEBUG=true, false otherwise. Keep false in production.
ALLOW_DEV_TUNNELS=true