# SAS RESERVE — backend environment configuration
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Email on Sir Francis M. Galon's existing account. Required before an
# administrator can assign the Assistant Campus Director approval role.
APPROVAL_LETTER_APPROVER_EMAIL=galon@school.edu
# Docker Compose (compose.yaml) adds one internal hostname. The Vite container
# proxies /api and /media with `changeOrigin`, so Django sees "backend" (the
# Compose service name) as the Host header and answers HTTP 400 if it is not
# allowed. Local (non-Docker) development does not need it.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Optional — falls back to SQLite when unset.
#
# DATABASE_URL=postgres://user:password@localhost:5432/sas_reserve


# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173


# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# Create these credentials in:
# Google Cloud Console → APIs & Services → Credentials
#
# OAuth client type:
# Web application
#
# IMPORTANT:
# Never put the real client secret in this example file.
# Never commit the real .env file.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The OAuth redirect_uri sent to Google for the authorization-code exchange.
# MUST match an Authorized redirect URI in Google Cloud Console
# character-for-character (scheme, host, port, path, no trailing params).
#
# Local development with the backend on 127.0.0.1:8000:
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback/
# Kept when running under Docker Compose: the browser still reaches Django at
# 127.0.0.1:8000 (the published port), while the Vite container proxies to the
# internal `backend` hostname, so pinning keeps the redirect_uri Google
# receives identical to this registered value.
#
# Production example:
# GOOGLE_REDIRECT_URI=https://your-production-domain.com/api/auth/google/callback/
#
# If left empty, the backend falls back to the host the browser actually used
# to reach Django — fine when Google redirects straight to the backend, but
# setting the pin explicitly is strongly recommended.


# ---------------------------------------------------------------------------
# Email (used for automatic upcoming-reservation reminders)
# ---------------------------------------------------------------------------
# Gmail example: create an App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords) and use it as EMAIL_HOST_PASSWORD.
# Never commit the real .env file or paste credentials into source code.
#
# Port 587 + TLS:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=SAS RESERVE <your-address@gmail.com>
# Optional SMTP socket timeout in seconds (default 20).
# EMAIL_TIMEOUT=20
#
# Port 465 + SSL instead of TLS:
# EMAIL_PORT=465
# EMAIL_USE_TLS=false
# EMAIL_USE_SSL=true


# ---------------------------------------------------------------------------
# Automatic reservation reminder scheduler
# ---------------------------------------------------------------------------
# The backend starts an hourly reminder check automatically. Leave enabled in
# normal deployments. For a production setup with a separate worker service,
# set this to false on the web service and run:
#   python manage.py run_reminder_scheduler
REMINDER_SCHEDULER_ENABLED=true
# REMINDER_SCHEDULER_INTERVAL_SECONDS=3600
# REMINDER_SCHEDULER_INITIAL_DELAY_SECONDS=10
# REMINDER_SCHEDULER_LEASE_SECONDS=180
# REMINDER_SCHEDULER_POLL_SECONDS=60
# RESERVATION_REMINDER_DAYS=3
# REMINDER_EMAIL_CLAIM_TIMEOUT_SECONDS=900


# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Public origin of the React application.
# Production fallback for OAuth redirects and email links.

PUBLIC_FRONTEND_URL=http://localhost:5173

# OAuth redirect origins trusted IN ADDITION to localhost (DEBUG only) and
# current VS Code Dev Tunnels (see ALLOW_DEV_TUNNELS). Exact origins only.
# Example:
# FRONTEND_ALLOWED_ORIGINS=https://myapp.example.com,https://staging.example.com
FRONTEND_ALLOWED_ORIGINS=

# Trust any https://<id>-<port>.<region>.devtunnels.ms origin for OAuth
# redirects, CORS, and (DEBUG only) ALLOWED_HOSTS. Default: true when
# DJANGO_DEBUG=true, false otherwise. Keep false in production.
ALLOW_DEV_TUNNELS=true