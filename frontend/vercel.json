{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://sas-reserve-api.onrender.com/api/:path*"
        },
        {
            "source": "/media/:path*",
            "destination": "https://sas-reserve-api.onrender.com/media/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}